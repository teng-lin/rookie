      "origin": "primary",
      "operations": [
        {
          "phase": "initial",
          "name": "rookie_post_2038",
          "value": "future",
          "path": "/",
          "expires": "Thu, 19 Jan 2040 03:14:07 GMT",
          "same_site": "Lax"
        }
      ],
      "expected": {
        "stored": true,
        "same_site": { "firefox": 1 },
        "expiry_seconds_from_now": { "min": 34559900, "max": 34560100 }
