{
  "schema_version": 1,
  "default_tiers": ["portable_smoke"],
  "tiers": {
    "portable_smoke": {
      "description": "Portable semantic correctness corpus run in the ordinary browser matrix."
    },
    "deep": {
      "description": "Engine-specific or lifecycle-sensitive cases for representative deep lanes."
    },
    "stress": {
      "description": "Volume and repetition cases for nightly soak lanes."
    }
  },
  "phase_order": ["initial", "mutate"],
  "origins": {
    "primary": {
      "hostname": "127.0.0.1",
      "included_by_domain_filter": true
    },
    "decoy": {
      "hostname": "localhost",
      "included_by_domain_filter": false
    }
  },
  "identities": {
    "filtered_flat": ["domain", "path", "name"],
    "unfiltered_flat": ["domain", "path", "name"],
    "detailed": [
      "cookie.domain",
      "cookie.path",
      "cookie.name",
      "context.top_frame_site_key",
      "context.has_cross_site_ancestor",
      "context.source_scheme",
      "context.source_port",
      "context.is_persistent",
      "context.origin_attributes",
      "context.user_context_id",
      "context.partition_key",
      "context.private_browsing_id"
    ]
  },
  "context_expectations": {
    "chromium": {
      "top_frame_site_key": null,
      "has_cross_site_ancestor": true,
      "source_scheme": "@source_scheme",
      "source_port": "@source_port",
      "is_persistent": "@is_persistent",
      "origin_attributes": null,
      "user_context_id": null,
      "partition_key": null,
      "private_browsing_id": null
    },
    "firefox": {
      "top_frame_site_key": null,
      "has_cross_site_ancestor": null,
      "source_scheme": null,
      "source_port": null,
      "is_persistent": null,
      "origin_attributes": "",
      "user_context_id": null,
      "partition_key": null,
      "private_browsing_id": null
    },
    "safari": {
      "top_frame_site_key": null,
      "has_cross_site_ancestor": null,
      "source_scheme": null,
      "source_port": null,
      "is_persistent": null,
      "origin_attributes": null,
      "user_context_id": null,
      "partition_key": null,
      "private_browsing_id": null
    }
  },
  "scenarios": [
    {
      "id": "baseline",
      "tiers": ["portable_smoke"],
      "applicability": {
        "engines": ["chromium", "firefox", "safari"],
        "platforms": ["linux", "macos", "windows"]
      },
      "origin": "primary",
      "operations": [
        {
          "phase": "initial",
          "name": "rookie_ci",
          "value": "bar",
          "path": "/",
          "max_age": 3600,
          "same_site": "Lax"
        }
      ],
      "expected": {
        "stored": true,
        "same_site": { "chromium": 1, "firefox": 1, "safari": -1 }
      }
    },
    {
      "id": "secure",
      "tiers": ["portable_smoke"],
      "applicability": {
        "engines": ["chromium", "firefox", "safari"],
        "platforms": ["linux", "macos", "windows"]
      },
      "origin": "primary",
      "operations": [
        {
          "phase": "initial",
          "name": "rookie_secure",
          "value": "secure",
          "path": "/",
          "max_age": 3600,
          "secure": true,
          "same_site": "Lax"
        }
      ],
      "expected": {
        "stored": true,
        "same_site": { "chromium": 1, "firefox": 1, "safari": -1 }
      }
    },
    {
