  "cookie_context_fields": {
    "top_frame_site_key": {
      "classification": "fixture_only",
      "engines": ["chromium"],
      "rationale": "Chromium CHIPS keys are currently asserted only from authored SQLite fixtures."
    },
    "has_cross_site_ancestor": {
      "classification": "fixture_only",
      "engines": ["chromium"],
      "rationale": "Chromium cross-site ancestry is currently asserted only from authored SQLite fixtures."
    },
    "source_scheme": {
      "classification": "fixture_only",
      "engines": ["chromium"],
      "rationale": "Chromium source schemes are currently asserted only from authored SQLite fixtures."
    },
    "source_port": {
      "classification": "fixture_only",
      "engines": ["chromium"],
      "rationale": "Chromium source ports are currently asserted only from authored SQLite fixtures."
    },
    "is_persistent": {
      "classification": "fixture_only",
      "engines": ["chromium", "gecko"],
      "rationale": "Live stores expose persistence but the E2E assertions do not verify its semantics."
    },
    "origin_attributes": {
      "classification": "fixture_only",
      "engines": ["gecko"],
      "rationale": "Live Firefox checks key presence while semantic values remain fixture-only."
    },
    "user_context_id": {
      "classification": "fixture_only",
      "engines": ["gecko"],
      "rationale": "Firefox container identities require a test container and remain fixture-only."
    },
    "partition_key": {
      "classification": "fixture_only",
      "engines": ["gecko"],
      "rationale": "Firefox dynamic partition keys have not been seeded by a live E2E browser."
    },
    "private_browsing_id": {
      "classification": "non_persistable",
      "engines": ["gecko"],
      "rationale": "Private browsing cookies are intentionally not written to the persistent cookie database."
    }
  },
  "fixture_limitations": {
    "linux/cachy": "Deprecated browser with no maintained release channel.",
    "macos/arc": "The custom application startup has no stable unattended profile and DevTools contract for a hosted runner.",
