{
  "schema_version": 2,
  "lanes": {
    "nightly_hosted": "Real browser seed+extract. Chrome/Firefox run in e2e.yml. e2e-release.yml installs or enables Chromium, Edge, Brave, Opera, Opera GX, Vivaldi, Yandex, LibreWolf, Zen, and normal-profile Safari on supported hosted images.",
    "release_fixture": "Deterministic engine checks plus browser-id coverage in e2e-release.yml (tag, release, workflow_dispatch); no browser is launched.",
    "manual": "Operator-owned fallback for a registry cell without a viable hosted runner. No current cells rely on it."
  },
  "depth_capabilities": {
    "registry_id": "The canonical browser ID is exposed by the public registry.",
    "browser_launch": "A real browser process persists the seeded cookie store.",
    "explicit_path": "Supported explicit-path APIs decode the seeded store.",
    "detailed": "Isolation-preserving detailed output is asserted.",
    "discovery": "Registry-root discovery identifies the expected profile and source path.",
    "recommended_read": "The recommended read API selects and decodes the expected discovered profile.",
    "crypto": "A real platform credential path decrypts a browser-produced value.",
    "exact_set": "The complete decoded cookie set is compared with an independent manifest.",
    "active_writer": "Extraction reads the same store while its browser is still writing it.",
    "partitioned": "Browser-produced partition or container identity is asserted semantically."
  },
  "depth_levels": {
    "none": "The cell makes no claim for this capability.",
    "fixture": "The capability is asserted with a generated or captured fixture.",
    "live": "The capability is asserted against output produced by a launched browser in the same job."
