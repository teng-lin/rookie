{
  "name": "rookie-cookies",
  "version": "0.6.0",
  "readme": "README.md",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "rookie_cookies",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "ava": "^8.0.1",
    "typescript": "^5.6.3"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "postartifacts": "node scripts/patch-loader.js",
    "build": "napi build --platform --release",
    "postbuild": "node scripts/patch-loader.js",
    "build:debug": "napi build --platform",
    "postbuild:debug": "node scripts/patch-loader.js",
    "build:test": "napi build --platform --release --features test-support",
    "postbuild:test": "node scripts/patch-loader.js",
    "prepack": "node scripts/patch-loader.js",
    "test": "ava",
    "test:worker-panic": "ava __test__/worker-panic.test-support.mjs",
    "typecheck": "tsc --noEmit --strict --target es2022 --moduleResolution node index.d.ts __test__/typing/consumer.ts",
    "universal": "napi universalize",
    "version": "napi version"
  },
  "optionalDependencies": {
    "rookie-cookies-darwin-arm64": "0.6.0",
    "rookie-cookies-darwin-x64": "0.6.0",
    "rookie-cookies-linux-arm64-gnu": "0.6.0",
    "rookie-cookies-linux-x64-gnu": "0.6.0",
    "rookie-cookies-win32-x64-msvc": "0.6.0"
  },
  "repository": "https://github.com/teng-lin/rookie-cookies",
  "description": "Load cookies from any browser on any platform"
}
