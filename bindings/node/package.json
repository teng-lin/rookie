{
  "name": "rookie-cookies",
  "version": "0.5.7",
  "readme": "README.md",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "rookie_cookies",
    "triples": {
      "additional": [
        "aarch64-apple-darwin"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.2",
    "ava": "^6.0.1"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "postartifacts": "node scripts/patch-loader.js",
    "build": "napi build --platform --release",
    "postbuild": "node scripts/patch-loader.js",
    "build:debug": "napi build --platform",
    "postbuild:debug": "node scripts/patch-loader.js",
    "prepack": "node scripts/patch-loader.js",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version"
  },
  "optionalDependencies": {
    "rookie-cookies-darwin-arm64": "0.5.7",
    "rookie-cookies-darwin-x64": "0.5.7",
    "rookie-cookies-linux-x64-gnu": "0.5.7",
    "rookie-cookies-win32-x64-msvc": "0.5.7"
  },
  "repository": "https://github.com/teng-lin/rookie-cookies",
  "description": "Load cookies from any browser on any platform"
}
