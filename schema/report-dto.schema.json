{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Generated by `cargo run --bin generate-dto-schema` from rookie-rs/src/browser/report_core.rs. Do not hand-edit -- see that file for the source of truth and schema/README.md for regeneration instructions.",
  "title": "rookie-cookies report DTO schema",
  "roots": {
    "Cookie": {
      "$ref": "#/definitions/Cookie"
    },
    "BrowserDescriptor": {
      "$ref": "#/definitions/BrowserDescriptor"
    },
    "ProfileDescriptor": {
      "$ref": "#/definitions/ProfileDescriptor"
    },
    "ExtractionReport": {
      "$ref": "#/definitions/ExtractionReport"
    },
    "ProfileExtraction": {
      "$ref": "#/definitions/ProfileExtraction"
    },
    "SourceExtraction": {
      "$ref": "#/definitions/SourceExtraction"
    },
    "ExtractionIssue": {
      "$ref": "#/definitions/ExtractionIssue"
    },
    "CookieSourceDescriptor": {
      "$ref": "#/definitions/CookieSourceDescriptor"
    },
    "CookieSourceIdentity": {
      "$ref": "#/definitions/CookieSourceIdentity"
    },
    "ProfileIdentity": {
      "$ref": "#/definitions/ProfileIdentity"
    },
    "BrowserCapabilitiesDescriptor": {
      "$ref": "#/definitions/BrowserCapabilitiesDescriptor"
    },
    "ExtractionStats": {
      "$ref": "#/definitions/ExtractionStats"
    },
    "ReportStats": {
      "$ref": "#/definitions/ReportStats"
    }
  },
  "definitions": {
    "Cookie": {
      "type": "object",
      "required": [
        "domain",
        "http_only",
        "name",
        "path",
        "same_site",
        "secure",
        "value"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "secure": {
          "type": "boolean"
        },
        "expires": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "http_only": {
          "type": "boolean"
        },
        "same_site": {
          "description": "Raw SameSite encoding from the source browser: `0` None, `1` Lax, `2` Strict, [`SAME_SITE_UNSPECIFIED`] when the store records none.",
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "BrowserDescriptor": {
      "description": "A browser registered for the running OS. Registration is not detection.",
      "type": "object",
      "required": [
        "aliases",
        "capabilities",
        "display_name",
        "engine",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display_name": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "capabilities": {
          "$ref": "#/definitions/BrowserCapabilitiesDescriptor"
        }
      }
    },
    "BrowserCapabilitiesDescriptor": {
      "description": "What a registered browser claims it can do on this platform.\n\nDeclared tiers come from the registry; `available_decryption_tiers` narrows them to the key providers actually compiled and enabled in this build, so it is the set a `decryptable` claim refers to.",
      "type": "object",
      "required": [
        "available_decryption_tiers",
        "declared_decryption_tiers",
        "persistent_formats",
        "session_formats"
      ],
      "properties": {
        "persistent_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "pattern": "[^a-z0-9_]"
            },
            "minLength": 1,
            "pattern": "^[a-z]"
          }
        },
        "session_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "pattern": "[^a-z0-9_]"
            },
            "minLength": 1,
            "pattern": "^[a-z]"
          }
        },
        "declared_decryption_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "pattern": "[^a-z0-9_]"
            },
            "minLength": 1,
            "pattern": "^[a-z]"
          }
        },
        "available_decryption_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "pattern": "[^a-z0-9_]"
            },
            "minLength": 1,
            "pattern": "^[a-z]"
          }
        }
      }
    },
    "ProfileDescriptor": {
      "description": "One discovered profile and its cookie sources.",
      "type": "object",
      "required": [
        "is_default",
        "profile",
        "sources"
      ],
      "properties": {
        "profile": {
          "$ref": "#/definitions/ProfileIdentity"
        },
        "is_default": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CookieSourceDescriptor"
          }
        }
      }
    },
    "ProfileIdentity": {
      "description": "Stable identity of one discovered profile.\n\n`profile_id` is the selection key; `path` is a display value that may be lossy on a non-UTF-8 filesystem, which `path_lossy` reports.",
      "type": "object",
      "required": [
        "browser_id",
        "display_name",
        "installation_id",
        "path",
        "path_lossy",
        "profile_id"
      ],
      "properties": {
        "browser_id": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "installation_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "display_name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "path_lossy": {
          "type": "boolean"
        }
      }
    },
    "CookieSourceDescriptor": {
      "description": "A cookie source a profile exposes, before any extraction is attempted.",
      "type": "object",
      "required": [
        "format",
        "path",
        "path_lossy",
        "precedence",
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "format": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "path": {
          "type": "string"
        },
        "path_lossy": {
          "type": "boolean"
        },
        "precedence": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "ExtractionReport": {
      "description": "A grouped extraction result.\n\n`issues` holds only request-wide, registry, discovery, and installation problems; anything narrower is attached to its profile or source.",
      "type": "object",
      "required": [
        "issues",
        "profiles",
        "status",
        "summary"
      ],
      "properties": {
        "schema_version": {
          "description": "Wire discriminator. Missing values from pre-PR3 JSON deserialize as v1.",
          "default": 1,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "status": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "termination": {
          "description": "Why execution stopped. This is independent from `status`: a timed-out request may still contain complete source outcomes collected earlier.",
          "default": "completed",
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "summary": {
          "$ref": "#/definitions/ReportStats"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProfileExtraction"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtractionIssue"
          }
        }
      }
    },
    "ReportStats": {
      "description": "Request-wide totals, including browsers that were registered but absent.",
      "type": "object",
      "required": [
        "browsers_detected",
        "browsers_not_detected",
        "cookies_emitted",
        "counters_saturated",
        "installations_discovered",
        "profiles_discovered",
        "registered_browsers",
        "rows_seen",
        "rows_skipped",
        "sources_failed",
        "sources_succeeded"
      ],
      "properties": {
        "registered_browsers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "browsers_detected": {
          "description": "Browsers whose discovery established that an installation was present.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "browsers_not_detected": {
          "description": "Browsers whose discovery completed and established absence.\n\nA request stopped before discovery completed is in neither detection counter in schema v1. Its error-severity stop issue and non-completed termination distinguish that unattempted/unknown state from absence.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "installations_discovered": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "profiles_discovered": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "sources_succeeded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "sources_failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rows_seen": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "cookies_emitted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rows_skipped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rows_rejected": {
          "description": "Sum of rejected rows across attempted sources.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "provider_failures": {
          "description": "Sum of per-source distinct Chromium provider-tier failures.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "counters_saturated": {
          "type": "boolean"
        }
      }
    },
    "ProfileExtraction": {
      "description": "One profile's sources, totals, and profile-scoped diagnostics.",
      "type": "object",
      "required": [
        "issues",
        "profile",
        "sources",
        "stats"
      ],
      "properties": {
        "profile": {
          "$ref": "#/definitions/ProfileIdentity"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceExtraction"
          }
        },
        "stats": {
          "$ref": "#/definitions/ExtractionStats"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtractionIssue"
          }
        }
      }
    },
    "SourceExtraction": {
      "description": "One attempted cookie source and the cookies it produced.\n\nCookies live here rather than on the profile so provenance survives. A profile-wide stream is the concatenation of the successful `selected` sources in role/precedence order.",
      "type": "object",
      "required": [
        "acquisition_strategy",
        "cookies",
        "issues",
        "selected",
        "source",
        "stats",
        "status"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/CookieSourceIdentity"
        },
        "status": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "selected": {
          "type": "boolean"
        },
        "acquisition_strategy": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Cookie"
          }
        },
        "stats": {
          "$ref": "#/definitions/ExtractionStats"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtractionIssue"
          }
        }
      }
    },
    "CookieSourceIdentity": {
      "description": "Identity of the source an extraction attempted.",
      "type": "object",
      "required": [
        "format",
        "path",
        "path_lossy",
        "precedence",
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "format": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "path": {
          "type": "string"
        },
        "path_lossy": {
          "type": "boolean"
        },
        "precedence": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "ExtractionStats": {
      "description": "Row accounting for one source or profile.\n\n`rows_skipped` counts relevant rows rejected after being seen because parsing, decryption, or decoding failed. Every counter is `u32`; a count that exceeded that range is clamped and sets `counters_saturated`.",
      "type": "object",
      "required": [
        "acquisition_attempts",
        "cookies_emitted",
        "counters_saturated",
        "rows_seen",
        "rows_skipped"
      ],
      "properties": {
        "rows_seen": {
          "description": "Rows *relevant to the request*: those matching the domain filter, plus any that failed before relevance could be determined. Rows the filter excluded are not counted, so `rows_seen - rows_skipped == cookies_emitted` holds and a consumer can read \"how much did this source lose?\" directly.\n\nSQL engines reduce candidates in their `WHERE` clause and enforce the final host boundary before incrementing these counters. File decoders, including Safari, likewise apply the request filter before incrementing their relevant-row counters.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "cookies_emitted": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rows_skipped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rows_rejected": {
          "description": "Rows rejected because stored fields were malformed or a value could not be authenticated or decoded. This is a subset of `rows_skipped`.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "provider_failures": {
          "description": "Distinct Chromium cipher tiers whose applicable credential provider failed. Aggregates sum the per-source distinct-tier counts.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "acquisition_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "counters_saturated": {
          "type": "boolean"
        }
      }
    },
    "ExtractionIssue": {
      "description": "A diagnostic attached to the request, a profile, or a source.\n\nRepeated row-level problems are aggregated by code and stage: `occurrences` counts them all while `samples` keeps a bounded excerpt.",
      "type": "object",
      "required": [
        "code",
        "message",
        "occurrences",
        "samples",
        "severity",
        "stage"
      ],
      "properties": {
        "code": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "stage": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "severity": {
          "type": "string",
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "cause": {
          "description": "Stable machine-readable origin of the failure.",
          "default": "",
          "type": "string"
        },
        "provider": {
          "description": "Credential/provider role when the cause originated at a provider seam.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "description": "Source-native cipher/provider tier, preserved without message parsing.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "retryability": {
          "description": "`retryable`, `not_retryable`, or `unknown`.",
          "default": "unknown",
          "type": "string"
        },
        "occurrences": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "browser_id": {
          "type": [
            "string",
            "null"
          ],
          "not": {
            "pattern": "[^a-z0-9_]"
          },
          "minLength": 1,
          "pattern": "^[a-z]"
        },
        "installation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
